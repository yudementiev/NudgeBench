*.py[cod]
.pytest_cache/
.DS_Store

.env

.claude/settings.local.json

# Fetched corpora belong to their authors; scripts/fetch_data.sh retrieves them.
data/

# Experiment outputs. The result summaries are the paper's numbers and are
# versioned; the raw call transcripts are the audit trail and are large, so they
# stay local - runs/neutral-baseline keeps a copy of the ones already reported.
runs/*.jsonl
runs/*.log
runs/*.bak
runs/neutral-baseline/

# LaTeX build artefacts; the .tex and .pdf are what matter.
paper/*.aux
paper/*.log
paper/*.out

data/taskbench/
