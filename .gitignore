.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

.env

.claude/settings.local.json

# Fetched corpora belong to their authors; scripts/fetch_data.sh retrieves them.
data/

# Experiment outputs are versioned in full: the result summaries are the paper's
# numbers, and the raw call transcripts are the audit trail behind them, so that
# every reported figure can be re-scored without re-spending. Working files are not.
runs/*.log
runs/*.bak
runs/neutral-baseline/

# LaTeX build artefacts; the .tex and .pdf are what matter.
paper/*.aux
paper/*.log
paper/*.out

data/taskbench/

# The write-up lives with the submission, not in the released benchmark.
paper/
